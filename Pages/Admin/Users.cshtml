@page
@model Campus_event.Pages.Admin.UsersModel
@{
	ViewData["Title"] = "User Management";
}
<div class="container">
    <h2>User Management</h2>
    <p>Search registered users, manage roles, and control account status.</p>

    <form method="get">
        <div class="row">
            <div class="col-sm-8">
                <input type="text" name="searchTerm" placeholder="Search by name or email..." />
            </div>
            <div class="col-sm-4">
                <input type="submit" value="Search" class="btn btn-primary" />
            </div>
        </div>
    </form>

    <br />

    <table class="table table-striped table-bordered table-hover">
        <thead>
            <tr>
                <th>Full Name</th>
                <th>Email</th>
                <th>Current Role</th>
                <th>Account Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Sample Admin</td>
                <td>admin@university.edu</td>
                <td>Administrator</td>
                <td><span class="text-success">Active</span></td>
                <td>
                    <form method="post">
                        <select name="selectedRole">
                            <option value="Student" selected="selected">Student</option>
                            <option value="Organizer">Organizer</option>
                            <option value="Administrator">Administrator</option>
                        </select>
                        <input type="submit" value="Update Role" class="btn btn-primary btn-sm" />
                        <button type="button" class="btn btn-danger btn-sm">Lock</button>
                    </form>
                </td>
            </tr>
        </tbody>
    </table>
</div>