@page
@model Campus_event.Pages.Admin.CategoriesModel
@{
	ViewData["Title"] = "Category Management";
}
<div class="container">
    <h2>Category Management</h2>
    <p>Create, edit, and remove event categories.</p>

    <div class="row">
        <div class="col-sm-4">
            <form method="post">
                <fieldset>
                    <legend>Add / Edit Category</legend>

                    <label for="categoryName">Category Name:</label>
                    <br />
                    <input type="text" id="categoryName" name="Name" placeholder="e.g., Workshop" />
                    <br />
                    <br />

                    <label for="categoryDesc">Description:</label>
                    <br />
                    <input type="text" id="categoryDesc" name="Description" placeholder="Short description" />
                    <br />
                    <br />

                    <input type="submit" value="Save Category" class="btn btn-success" />
                    <input type="reset" value="Clear" class="btn btn-secondary" />
                </fieldset>
            </form>
        </div>

        <div class="col-sm-8">
            <table class="table table-striped table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Workshop</td>
                        <td>Hands-on campus sessions</td>
                        <td>
                            <div class="btn-group">
                                <button type="button" class="btn btn-warning btn-sm">Edit</button>
                                <button type="button" class="btn btn-danger btn-sm">Delete</button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
